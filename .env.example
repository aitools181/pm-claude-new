# Copy this file to .env for local Docker use. Never commit real production secrets.
# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Additional comma-separated browser origins, if any. APP_URL is always allowed.
CORS_ORIGINS=
# Leave blank for same-origin browser API + Socket.IO via Next rewrites.
NEXT_PUBLIC_API_URL=

# ---- PostgreSQL 18 ----
# NOTE: Postgres only applies POSTGRES_PASSWORD the first time it initialises an
# empty data volume. Changing this later does NOT change the password inside an
# existing pgdata volume - the API will then fail with
# "password authentication failed for user pm". To rotate it, run:
#   docker exec <postgres-container> psql -U pm -d pm_platform \
#     -c "ALTER USER pm WITH PASSWORD 'new-password';"
# and set the same value here.
POSTGRES_PASSWORD=replace_with_a_random_database_password
DATABASE_URL=postgresql://pm:replace_with_a_random_database_password@postgres:5432/pm_platform

# ---- Redis 8 ----
REDIS_URL=redis://redis:6379

# ---- MinIO (object storage) ----
MINIO_ROOT_USER=replace_with_a_random_storage_user
MINIO_ROOT_PASSWORD=replace_with_a_random_storage_password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_a_random_storage_user
S3_SECRET_KEY=replace_with_a_random_storage_password
S3_BUCKET=pm-platform

# ---- Security ----
# Generate a high-entropy secret (32+ chars) for every deployment.
SESSION_SECRET=replace_with_at_least_32_random_characters_here

# ---- AI (development defaults to deterministic mock; production must choose disabled or openai_compatible) ----
AI_PROVIDER=mock
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=replace_me
# AI_MODEL=replace_me
