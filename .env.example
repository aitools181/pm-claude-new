# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- PostgreSQL 18 ----
DATABASE_URL=postgresql://pm:pm_password@postgres:5432/pm_platform

# ---- Redis 8 ----
REDIS_URL=redis://redis:6379

# ---- MinIO (object storage) ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pm_minio_user
S3_SECRET_KEY=pm_minio_password
S3_BUCKET=pm-platform

# ---- Security (Phase 0: placeholder, real auth begins Phase 1A) ----
SESSION_SECRET=change_me_in_real_deployments_min_32_chars_long
